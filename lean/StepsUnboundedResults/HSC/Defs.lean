/-
HSC/Defs.lean

Frozen shared API for the Lean formalization of the composition-factor layer of the
Herzog–Schönheim (HS) conjecture (corpus result R005, structural layer).

Main objects:
* `indexSet G` : the set of distinct subgroup indices `[G : H]` of a finite group `G`.
* `J G`        : Garonzi–Margolis' reciprocal index mass `∑_{n ∈ I(G)} 1/n`.
* `leftCoset`, `CosetPartition G`, `IsHS G` : the HS conjecture for a finite group.
* `MonoidGen A`, `MassBound A c` : the multiplicative monoid generated by a finite set of
  naturals, and the reciprocal-mass bound on its finite initial segments (the R003 device).
* `BuiltFrom S G` : `G` is obtained from `S` by a finite sequence of extensions
  (the extension-closure form of "every composition factor of `G` is isomorphic to `S`").

This file is imported by `HSC.Criterion`, `HSC.Extension`, `HSC.A5Monoid`, `HSC.A5Index`
and `HSC.Assembly`; its API is frozen.
-/
import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.IndexNormal
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.Subgroup.Simple
import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.NumberTheory.Divisors
import Mathlib.Data.Rat.Lemmas
import Mathlib.Algebra.Order.Field.GeomSum
import Mathlib.Tactic.Positivity

open scoped Classical

namespace HSC

/-! ## The index set and the reciprocal mass `J` -/

/-- The set of distinct subgroup indices of a finite group. -/
noncomputable def indexSet (G : Type*) [Group G] [Finite G] : Finset ℕ := by
  classical
  exact (Nat.divisors (Nat.card G)).filter (fun n => ∃ H : Subgroup G, H.index = n)

theorem mem_indexSet {G : Type*} [Group G] [Finite G] {n : ℕ} :
    n ∈ indexSet G ↔ n ∣ Nat.card G ∧ ∃ H : Subgroup G, H.index = n := by
  classical
  rw [indexSet, Finset.mem_filter, Nat.mem_divisors]
  constructor
  · rintro ⟨⟨h1, -⟩, h2⟩
    exact ⟨h1, h2⟩
  · rintro ⟨h1, h2⟩
    exact ⟨⟨h1, Nat.card_ne_zero.mpr ⟨⟨1⟩, ‹Finite G›⟩⟩, h2⟩

theorem index_mem_indexSet (G : Type*) [Group G] [Finite G] (H : Subgroup G) :
    H.index ∈ indexSet G := by
  rw [mem_indexSet]
  exact ⟨Subgroup.index_dvd_card H, H, rfl⟩

/-- The Garonzi–Margolis reciprocal mass `J(G) = ∑_{n ∈ I(G)} 1/n` of a finite group. -/
noncomputable def J (G : Type*) [Group G] [Finite G] : ℚ :=
  ∑ n ∈ indexSet G, (1 : ℚ) / n

theorem J_nonneg (G : Type*) [Group G] [Finite G] : 0 ≤ J G := by
  classical
  rw [J]
  refine Finset.sum_nonneg fun n _ => ?_
  exact div_nonneg (zero_le_one' ℚ) (Nat.cast_nonneg n)

/-! ## The Herzog–Schönheim property -/

/-- The left coset `xH` as an explicit set of group elements. -/
def leftCoset {G : Type*} [Group G] (x : G) (H : Subgroup G) : Set G :=
  {g | x⁻¹ * g ∈ H}

@[simp]
theorem mem_leftCoset {G : Type*} [Group G] {x g : G} {H : Subgroup G} :
    g ∈ leftCoset x H ↔ x⁻¹ * g ∈ H := Iff.rfl

theorem leftCoset_eq_image {G : Type*} [Group G] (x : G) (H : Subgroup G) :
    leftCoset x H = (fun h : H => x * h) '' Set.univ := by
  ext g
  constructor
  · intro hg
    exact ⟨⟨x⁻¹ * g, hg⟩, trivial, by simp⟩
  · rintro ⟨h, -, rfl⟩
    simp [h.2]

/-- A partition of a group into finitely many cosets of *proper* subgroups (at least two cosets). -/
structure CosetPartition (G : Type*) [Group G] where
  ι : Type
  fintype : Fintype ι
  H : ι → Subgroup G
  x : ι → G
  proper : ∀ i, H i ≠ ⊤
  two_le : 2 ≤ Nat.card ι
  cover : ∀ g : G, ∃ i, g ∈ leftCoset (x i) (H i)
  disjoint : ∀ i j, i ≠ j → Disjoint (leftCoset (x i) (H i)) (leftCoset (x j) (H j))

attribute [instance] CosetPartition.fintype

/-- `G` satisfies the Herzog–Schönheim conjecture: in every coset partition with at least two
parts, two of the subgroups have the same index. -/
def IsHS (G : Type*) [Group G] : Prop :=
  ∀ P : CosetPartition G, ∃ i j : P.ι, i ≠ j ∧ (P.H i).index = (P.H j).index

/-! ## The multiplicative monoid generated by a finite set of naturals -/

/-- The multiplicative monoid (as a subset of `ℕ`) generated by a finset of naturals. -/
def MonoidGen (A : Finset ℕ) : Set ℕ :=
  {n | ∃ L : List ℕ, (∀ a ∈ L, a ∈ A) ∧ n = L.prod}

theorem one_mem_MonoidGen (A : Finset ℕ) : 1 ∈ MonoidGen A :=
  ⟨[], by simp⟩

theorem MonoidGen.mul_mem {A : Finset ℕ} {m n : ℕ} (hm : m ∈ MonoidGen A)
    (hn : n ∈ MonoidGen A) : m * n ∈ MonoidGen A := by
  obtain ⟨L, hL, rfl⟩ := hm
  obtain ⟨M, hM, rfl⟩ := hn
  refine ⟨L ++ M, ?_, by simp⟩
  intro a ha
  rcases List.mem_append.mp ha with h | h
  · exact hL a h
  · exact hM a h

theorem subset_MonoidGen {A : Finset ℕ} {n : ℕ} (h : n ∈ A) : n ∈ MonoidGen A :=
  ⟨[n], by simpa using h, by simp⟩

theorem MonoidGen_mono {A B : Finset ℕ} (h : A ⊆ B) : MonoidGen A ⊆ MonoidGen B := by
  rintro n ⟨L, hL, rfl⟩
  exact ⟨L, fun a ha => h (hL a ha), rfl⟩

/-- The elements of the monoid generated by `A` that are `≤ N`. -/
noncomputable def monoidUpTo (A : Finset ℕ) (N : ℕ) : Finset ℕ := by
  classical
  exact (Finset.range (N + 1)).filter (fun n => n ∈ MonoidGen A)

theorem mem_monoidUpTo {A : Finset ℕ} {N n : ℕ} :
    n ∈ monoidUpTo A N ↔ n ≤ N ∧ n ∈ MonoidGen A := by
  classical
  rw [monoidUpTo, Finset.mem_filter, Finset.mem_range, Nat.lt_succ_iff]

theorem monoidUpTo_mono {A B : Finset ℕ} (h : A ⊆ B) (N : ℕ) :
    monoidUpTo A N ⊆ monoidUpTo B N := fun _ hn =>
  mem_monoidUpTo.mpr ⟨(mem_monoidUpTo.mp hn).1, MonoidGen_mono h (mem_monoidUpTo.mp hn).2⟩

/-- `MassBound A c` says: the reciprocal mass of every finite initial segment of the
multiplicative monoid generated by `A`, excluding the element `1`, is at most `c`.
This is the formal form of the R003 device: `c = 5611/5852` for `A = I(A₅)`. -/
noncomputable def MassBound (A : Finset ℕ) (c : ℚ) : Prop :=
  ∀ N : ℕ, (∑ n ∈ (monoidUpTo A N).filter (fun n => 1 < n), (1 : ℚ) / n) ≤ c

/-! ## The alternating group `A₅` -/

/-- The alternating group `A₅`. -/
abbrev Alt5 : Type := ↥(alternatingGroup (Fin 5))

/-- The nine distinct subgroup indices of `A₅`
(corpus baseline, GAP-verified: `I(A₅) = {1,5,6,10,12,15,20,30,60}`). -/
def a5IndexSet : Finset ℕ := {1, 5, 6, 10, 12, 15, 20, 30, 60}

/-! ## Groups built from a fixed group by extensions -/

/-- `BuiltFrom S G`: `G` is obtained from `S` by a finite sequence of extensions.
For finite groups this is the extension-closure form of "every composition factor of `G`
is isomorphic to `S`". -/
inductive BuiltFrom (S : Type) [Group S] : (G : Type) → [Group G] → Prop
  | iso (G : Type) [Group G] (e : G ≃* S) : BuiltFrom S G
  | ext (G : Type) [Group G] (N : Subgroup G) [N.Normal] :
      BuiltFrom S N → BuiltFrom S (G ⧸ N) → BuiltFrom S G

theorem BuiltFrom.of_iso (S : Type) [Group S] {G : Type} [Group G] (e : G ≃* S) :
    BuiltFrom S G := BuiltFrom.iso G e

end HSC
