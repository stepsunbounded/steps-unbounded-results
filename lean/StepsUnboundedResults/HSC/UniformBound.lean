/-
HSC/UniformBound.lean

The *uniform* (Euler-product) monoid-mass bound for the R005 / Herzog–Schönheim audit.

`MonoidGen A` is the multiplicative monoid generated by a finite set `A ⊆ ℕ`, and
`MassBound A c` says that every finite initial segment of it has reciprocal mass at most `c`.
This file proves the uniform bound

    Λ(A) ≤ ∏_{a ∈ A, 1 < a} (1 - 1/a)⁻¹ - 1        (`massBound_euler`)

which needs no computation specific to `A`: the multisets over the non-trivial generators
*cover* every `n > 1` of the monoid (each at least once), so

    Λ ≤ Σ_{k : A₊ → ℕ} ∏_{a ∈ A₊} a^{-k a} = ∏_{a ∈ A₊} (1 - 1/a)⁻¹ - 1,

the empty exponent vector (i.e. `n = 1`) being the `- 1`.  Consequently, if the Euler product
is `< 2` then `MassBound A c` holds with `c < 1` (`massBound_euler_of_lt_two`), which is the
hypothesis consumed by `HSC.Assembly.isHS_of_indexSet_subset`.

The bound is *not* strong enough for `A = I(A₅)`: `euler_a5_gt_two` shows that its Euler product
equals `5400000/2503193 ≈ 2.1572 > 2`, so the uniform criterion fails exactly at `A₅` and the
exact monoid mass `5611/5852` (`HSC.A5Monoid`) is needed there.

Everything is done with finite sums over `ℚ`; no infinite series are used.
-/
import StepsUnboundedResults.HSC.Defs
import Mathlib.Tactic

open scoped Classical
open Finset

namespace HSC

noncomputable def eps (A : Finset ℕ) : ℚ := ∑ a ∈ A.filter (fun a => 1 < a), (1 : ℚ) / a

theorem eps_nonneg (A : Finset ℕ) : 0 ≤ eps A := by
  rw [eps]
  exact Finset.sum_nonneg fun a _ => div_nonneg (zero_le_one' ℚ) (Nat.cast_nonneg a)

lemma le_pow_self {m k : ℕ} (hm : 2 ≤ m) : k ≤ m ^ k :=
  le_trans (Nat.lt_two_pow_self (n := k)).le (Nat.pow_le_pow_left hm k)

lemma euler_geom_tail_le (a N : ℕ) (ha : 1 < a) :
    ∑ k ∈ range (N + 1), ((1 : ℚ) / a) ^ k ≤ ((1 : ℚ) - 1 / a)⁻¹ := by
  have ha0 : (0 : ℚ) < a := by positivity
  have hlt : (1 : ℚ) / a < 1 := by
    rw [div_lt_one ha0]
    exact_mod_cast ha
  have hpos : 0 < (1 : ℚ) - 1 / a := sub_pos.mpr hlt
  have hx0 : (0 : ℚ) ≤ (1 : ℚ) / a := by positivity
  have hS : (∑ k ∈ range (N + 1), ((1 : ℚ) / a) ^ k) * (1 - (1 : ℚ) / a) ≤ 1 := by
    rw [geom_sum_mul_neg]
    have : (0 : ℚ) ≤ ((1 : ℚ) / a) ^ (N + 1) := pow_nonneg hx0 _
    linarith
  calc ∑ k ∈ range (N + 1), ((1 : ℚ) / a) ^ k
      = (∑ k ∈ range (N + 1), ((1 : ℚ) / a) ^ k) * (1 - (1 : ℚ) / a)
          * (1 - (1 : ℚ) / a)⁻¹ := by
        rw [mul_assoc, mul_inv_cancel₀ (ne_of_gt hpos), mul_one]
    _ ≤ 1 * (1 - (1 : ℚ) / a)⁻¹ := mul_le_mul_of_nonneg_right hS (inv_nonneg.mpr hpos.le)
    _ = ((1 : ℚ) - 1 / a)⁻¹ := by rw [one_mul]

private def boxTerm (B : Finset ℕ) (N : ℕ) (k : {a // a ∈ B} → Fin (N + 1)) : ℚ :=
  ∏ a : {a // a ∈ B}, ((1 : ℚ) / (a : ℕ)) ^ (k a : ℕ)

private lemma exists_exp_vec {A B : Finset ℕ} (hB : ∀ a, a ∈ B ↔ a ∈ A ∧ 1 < a) {N n : ℕ}
    (hn : n ∈ (monoidUpTo A N).filter (fun n => 1 < n)) :
    ∃ k : {a // a ∈ B} → Fin (N + 1), ∏ a : {a // a ∈ B}, (a : ℕ) ^ (k a : ℕ) = n := by
  classical
  have hn1 : 1 < n := (Finset.mem_filter.mp hn).2
  have hnN : n ≤ N := (mem_monoidUpTo.mp (Finset.mem_filter.mp hn).1).1
  obtain ⟨L, hLA, hLn⟩ := (mem_monoidUpTo.mp (Finset.mem_filter.mp hn).1).2
  have h0 : (0 : ℕ) ∉ L := by
    intro hmem
    have : L.prod = 0 := List.prod_eq_zero_iff.mpr hmem
    omega
  set S : Finset ℕ := L.toFinset.filter (fun a => 1 < a) with hSdef
  have hSB : S ⊆ B := by
    intro i hi
    rw [hSdef, Finset.mem_filter] at hi
    exact (hB i).mpr ⟨hLA i (List.mem_toFinset.mp hi.1), hi.2⟩
  have hBS : ∏ i ∈ B, i ^ L.count i = ∏ i ∈ S, i ^ L.count i :=
    (Finset.prod_subset hSB fun x hxB hxS => by
      have hx1 : 1 < x := ((hB x).mp hxB).2
      have hxL : x ∉ L := fun hx =>
        hxS (by rw [hSdef, Finset.mem_filter]; exact ⟨List.mem_toFinset.mpr hx, hx1⟩)
      rw [List.count_eq_zero_of_not_mem hxL, pow_zero]).symm
  have hSL : ∏ i ∈ S, i ^ L.count i = ∏ i ∈ L.toFinset, i ^ L.count i := by
    refine Finset.prod_subset (by rw [hSdef]; exact Finset.filter_subset _ _) fun x hxL hxS => ?_
    have hxle : x ≤ 1 := by
      by_contra h
      exact hxS (by rw [hSdef, Finset.mem_filter]; exact ⟨hxL, Nat.lt_of_not_le h⟩)
    have hx0 : x ≠ 0 := by
      intro hx
      exact h0 (hx ▸ List.mem_toFinset.mp hxL)
    rw [show x = 1 by omega, one_pow]
  have hprod : ∏ i ∈ B, i ^ L.count i = n := by
    rw [hBS, hSL, ← Finset.prod_list_count L]
    exact hLn.symm
  have hrec : ∏ a : {a // a ∈ B}, (a : ℕ) ^ (L.count (a : ℕ)) = n := by
    rw [Finset.univ_eq_attach]
    exact (Finset.prod_attach B fun i => i ^ L.count i).trans hprod
  refine ⟨fun a => ⟨L.count (a : ℕ), Nat.lt_succ_of_le ?_⟩, ?_⟩
  · have hsingle : (a : ℕ) ^ L.count (a : ℕ) ≤ ∏ i ∈ B, i ^ L.count i := by
      refine Finset.single_le_prod' (s := B) (f := fun i => i ^ L.count i)
        (fun i hi => one_le_pow₀ (le_of_lt ((hB i).mp hi).2)) a.2
    rw [hprod] at hsingle
    have ha2 : 2 ≤ (a : ℕ) := by have := ((hB (a : ℕ)).mp a.2).2; omega
    have hk : L.count (a : ℕ) ≤ (a : ℕ) ^ L.count (a : ℕ) := le_pow_self (k := L.count (a : ℕ)) ha2
    omega
  · simpa using hrec

theorem massBound_of_filter (A B : Finset ℕ) (hB : ∀ a, a ∈ B ↔ a ∈ A ∧ 1 < a) :
    MassBound A ((∏ a ∈ B, ((1 : ℚ) - 1 / a)⁻¹) - 1) := by
  intro N
  classical
  set s : Finset ℕ := (monoidUpTo A N).filter (fun n => 1 < n) with hs
  have key : ∀ n ∈ s, ∃ k : {a // a ∈ B} → Fin (N + 1), ∏ a : {a // a ∈ B}, (a : ℕ) ^ (k a : ℕ) = n :=
    fun n hn => exists_exp_vec hB (hs ▸ hn)
  let F : ℕ → ({a // a ∈ B} → Fin (N + 1)) :=
    fun n => if h : n ∈ s then Classical.choose (key n h) else 0
  have hF : ∀ n ∈ s, ∏ a : {a // a ∈ B}, (a : ℕ) ^ (F n a : ℕ) = n := by
    intro n hn
    have := Classical.choose_spec (key n hn)
    simpa only [F, dif_pos hn] using this
  have hinj : Set.InjOn F ↑s := by
    intro m hm n hn hmn
    rw [← hF m hm, ← hF n hn, hmn]
  have hquo : ∀ n ∈ s, (1 : ℚ) / n
      = ∏ a : {a // a ∈ B}, ((1 : ℚ) / (a : ℕ)) ^ (F n a : ℕ) := by
    intro n hn
    have hcast : (n : ℚ) = ∏ a : {a // a ∈ B}, (((a : ℕ)) : ℚ) ^ (F n a : ℕ) := by
      conv_lhs => rw [← hF n hn]
      push_cast
      rfl
    calc (1 : ℚ) / n = (n : ℚ)⁻¹ := one_div _
      _ = (∏ a : {a // a ∈ B}, (((a : ℕ)) : ℚ) ^ (F n a : ℕ))⁻¹ := by rw [hcast]
      _ = ∏ a : {a // a ∈ B}, ((((a : ℕ)) : ℚ) ^ (F n a : ℕ))⁻¹ :=
            (Finset.prod_inv_distrib
              (fun a : {a // a ∈ B} => (((a : ℕ)) : ℚ) ^ (F n a : ℕ))).symm
      _ = ∏ a : {a // a ∈ B}, ((1 : ℚ) / (a : ℕ)) ^ (F n a : ℕ) := by
            refine Finset.prod_congr rfl fun a _ => ?_
            rw [one_div, inv_pow]
  have hzero : (0 : {a // a ∈ B} → Fin (N + 1)) ∉ s.image F := by
    intro hmem
    obtain ⟨n, hn, hnF⟩ := Finset.mem_image.mp hmem
    have hn1 : 1 < n := (Finset.mem_filter.mp (hs ▸ hn)).2
    have h1 := hF n hn
    rw [hnF] at h1
    simp at h1
    omega
  have herase : ∑ h ∈ (Finset.univ.erase (0 : {a // a ∈ B} → Fin (N + 1))), boxTerm B N h
      = (∑ h : {a // a ∈ B} → Fin (N + 1), boxTerm B N h) - 1 := by
    rw [Finset.sum_erase_eq_sub (Finset.mem_univ (0 : {a // a ∈ B} → Fin (N + 1)))]
    simp [boxTerm]
  have hle2 : ∑ h ∈ s.image F, boxTerm B N h
      ≤ (∑ h : {a // a ∈ B} → Fin (N + 1), boxTerm B N h) - 1 := by
    rw [← herase]
    refine Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_
    · intro h hh
      exact Finset.mem_erase.mpr ⟨fun h0 => hzero (h0 ▸ hh), Finset.mem_univ h⟩
    · intro h _ _
      simp only [boxTerm]
      exact Finset.prod_nonneg fun a _ =>
        pow_nonneg (div_nonneg zero_le_one (Nat.cast_nonneg _)) _
  have hbox : (∑ h : {a // a ∈ B} → Fin (N + 1), boxTerm B N h)
      ≤ ∏ a ∈ B, ((1 : ℚ) - 1 / a)⁻¹ := by
    calc ∑ h : {a // a ∈ B} → Fin (N + 1), boxTerm B N h
        = ∏ a : {a // a ∈ B}, ∑ k : Fin (N + 1), ((1 : ℚ) / (a : ℕ)) ^ (k : ℕ) :=
          (Fintype.prod_sum
            (fun (a : {a // a ∈ B}) (k : Fin (N + 1)) =>
              ((1 : ℚ) / (a : ℕ)) ^ (k : ℕ))).symm
      _ = ∏ a : {a // a ∈ B}, ∑ k ∈ range (N + 1), ((1 : ℚ) / (a : ℕ)) ^ k := by
          refine Finset.prod_congr rfl fun a _ => ?_
          exact Fin.sum_univ_eq_sum_range (fun k => ((1 : ℚ) / (a : ℕ)) ^ k) (N + 1)
      _ ≤ ∏ a : {a // a ∈ B}, ((1 : ℚ) - 1 / (a : ℕ))⁻¹ := by
          refine Finset.prod_le_prod (fun a _ => ?_) (fun a _ => ?_)
          · exact Finset.sum_nonneg fun k _ =>
              pow_nonneg (div_nonneg zero_le_one (Nat.cast_nonneg _)) _
          · exact euler_geom_tail_le (a : ℕ) N ((hB (a : ℕ)).mp a.2).2
      _ = ∏ a ∈ B, ((1 : ℚ) - 1 / a)⁻¹ := by
          rw [Finset.univ_eq_attach]
          exact Finset.prod_attach B (fun a => ((1 : ℚ) - 1 / a)⁻¹)
  calc ∑ n ∈ s, (1 : ℚ) / n
      = ∑ n ∈ s, boxTerm B N (F n) := Finset.sum_congr rfl hquo
    _ = ∑ h ∈ s.image F, boxTerm B N h := (Finset.sum_image hinj).symm
    _ ≤ (∑ h : {a // a ∈ B} → Fin (N + 1), boxTerm B N h) - 1 := hle2
    _ ≤ (∏ a ∈ B, ((1 : ℚ) - 1 / a)⁻¹) - 1 := by linarith

theorem massBound_euler (A : Finset ℕ) :
    MassBound A ((∏ a ∈ A.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) - 1) :=
  massBound_of_filter A (A.filter (fun a => 1 < a)) fun _ => Finset.mem_filter

theorem massBound_euler_of_lt_two (A : Finset ℕ)
    (h : (∏ a ∈ A.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) < 2) :
    MassBound A ((∏ a ∈ A.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) - 1) ∧
      (∏ a ∈ A.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) - 1 < 1 :=
  ⟨massBound_euler A, by linarith⟩

private lemma a5_filter_eq :
    a5IndexSet.filter (fun a => 1 < a) = ({5, 6, 10, 12, 15, 20, 30, 60} : Finset ℕ) := by
  decide

theorem euler_a5_value :
    (∏ a ∈ a5IndexSet.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) = 5400000 / 2503193 := by
  rw [a5_filter_eq]
  norm_num

theorem euler_a5_gt_two : 2 < ∏ a ∈ a5IndexSet.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹ := by
  rw [euler_a5_value]
  norm_num

end HSC
