/-
HSC/SimpleHypotheses.lean

The **interface** of the R005 homogeneous-composition-factor theorem: exactly what the universal
statement still assumes per finite simple group `S`, as Lean objects, so that the gap is a *named
hypothesis* (`SimpleData S`) rather than a data table.

The universal statement (R005) is: for every finite nonabelian simple group `S`, every finite group
whose composition factors are all isomorphic to `S` satisfies Herzog–Schönheim. The *mechanism* is
already Lean:

* `HSC.indexSet_subset_monoidGen_of_compFactors` — every index of `G` lies in the monoid `M(A)`
  generated by a set `A` covering `I(S)` (extension induction, `HSC.CompFactors`);
* `HSC.isHS_of_compFactors` — assembly with the monoid mass bound (`HSC.CompFactors`);
* `HSC.massBound_euler` and `HSC.isHS_of_compFactors_of_euler` — the uniform Euler-product route
  of audit §9.2 (`HSC.UniformBound`, `HSC.Headline`);
* `HSC.HS_of_compFactors_Alt5` — the single instance the development discharges.

What is *not* Lean is the per-`S` input: an explicit finite set `A` of candidate indices covering
`I(S)`, together with a numeric bound on the reciprocal mass of the monoid `M(A)` it generates.
This file packages that input as `SimpleData S`, proves the consuming theorem, discharges `A₅`, and
records the universal gap as a named hypothesis rather than an unstated assumption.
-/
import StepsUnboundedResults.HSC.Defs
import StepsUnboundedResults.HSC.Assembly
import StepsUnboundedResults.HSC.CompFactors
import StepsUnboundedResults.HSC.A5Index
import StepsUnboundedResults.HSC.A5Monoid
import StepsUnboundedResults.HSC.UniformBound
import Mathlib.LinearAlgebra.Matrix.ProjectiveSpecialLinearGroup
import Mathlib.FieldTheory.Finite.GaloisField
import Mathlib.Tactic

open scoped Classical
open scoped MatrixGroups

namespace HSC

structure SimpleData (S : Type) [Group S] [Finite S] where
  A : Finset ℕ
  index_subset : ∀ n ∈ indexSet S, n ∈ MonoidGen A
  c : ℚ
  massBound : MassBound A c
  c_lt_one : c < 1

namespace SimpleData

noncomputable def ofEulerSet (S : Type) [Group S] [Finite S] (A : Finset ℕ)
    (hsub : ∀ n ∈ indexSet S, n ∈ MonoidGen A)
    (h : (∏ a ∈ A.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) < 2) : SimpleData S where
  A := A
  index_subset := hsub
  c := (∏ a ∈ A.filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) - 1
  massBound := massBound_euler A
  c_lt_one := by linarith

noncomputable def ofEuler (S : Type) [Group S] [Finite S]
    (h : (∏ a ∈ (indexSet S).filter (fun a => 1 < a), ((1 : ℚ) - 1 / a)⁻¹) < 2) :
    SimpleData S :=
  ofEulerSet S (indexSet S) (fun _ hn => subset_MonoidGen hn) h

end SimpleData

structure HomogeneousData (S : Type) [Group S] [Finite S] (G : Type) [Group G] [Finite G] where
  data : SimpleData S
  compFactors : CompFactorsIso S G

theorem isHS_of_compFactors_of_simpleData {S : Type} [Group S] [Finite S] (D : SimpleData S)
    {G : Type} [Group G] [Finite G] (hc : CompFactorsIso S G) : IsHS G :=
  isHS_of_compFactors D.index_subset D.massBound D.c_lt_one hc

theorem isHS_of_homogeneousData {S : Type} [Group S] [Finite S] {G : Type} [Group G] [Finite G]
    (D : HomogeneousData S G) : IsHS G :=
  isHS_of_compFactors_of_simpleData D.data D.compFactors

theorem isHS_of_builtFrom_of_simpleData {S : Type} [Group S] [Finite S] (D : SimpleData S)
    {G : Type} [Group G] [Finite G] (hb : BuiltFrom S G) : IsHS G :=
  isHS_of_builtFrom D.index_subset D.massBound D.c_lt_one hb

def SimpleDataAll : Prop :=
  ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S → Nonempty (SimpleData S)

theorem isHS_of_compFactors_of_simpleDataAll (H : SimpleDataAll) {S : Type} [Group S] [Finite S]
    (hS : IsSimpleGroup S) {G : Type} [Group G] [Finite G] (hc : CompFactorsIso S G) : IsHS G :=
  isHS_of_compFactors_of_simpleData (H S hS).some hc

noncomputable def simpleData_alt5 : SimpleData Alt5 where
  A := a5IndexSet
  index_subset := fun n hn => subset_MonoidGen (a5_indexSet_subset n hn)
  c := 5611 / 5852
  massBound := massBound_a5IndexSet
  c_lt_one := by norm_num

theorem simpleData_alt5_spec :
    simpleData_alt5.A = a5IndexSet ∧ simpleData_alt5.c = 5611 / 5852 :=
  ⟨rfl, rfl⟩

theorem isHS_of_compFactors_Alt5_viaSimpleData {G : Type} [Group G] [Finite G]
    (hc : CompFactorsIso Alt5 G) : IsHS G :=
  isHS_of_compFactors_of_simpleData simpleData_alt5 hc

theorem isHS_Alt5_viaSimpleData : IsHS Alt5 :=
  isHS_of_compFactors_Alt5_viaSimpleData compFactorsIso_alt5_self

noncomputable abbrev PSL2_4 : Type := PSL(2, GaloisField 2 2)

noncomputable def PSL2_missingInput (F : Type) [Field F] [Finite F] : Prop :=
  Nonempty (SimpleData (PSL(2, F)))

noncomputable def PSL2_4_missingInput : Prop :=
  PSL2_missingInput (GaloisField 2 2)

theorem isHS_of_compFactors_PSL2_4_conditional (h : PSL2_4_missingInput)
    {G : Type} [Group G] [Finite G] (hc : CompFactorsIso PSL2_4 G) : IsHS G :=
  isHS_of_compFactors_of_simpleData h.some hc

theorem isHS_of_compFactors_PSL2_conditional {F : Type} [Field F] [Finite F]
    (h : PSL2_missingInput F) {G : Type} [Group G] [Finite G]
    (hc : CompFactorsIso (PSL(2, F)) G) : IsHS G :=
  isHS_of_compFactors_of_simpleData h.some hc

end HSC
